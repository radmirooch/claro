# Copy to .env. Shell environment variables override this file.
PORT=4317
WHISPER_PORT=4318
# whisper-server must be in PATH, or set an absolute path:
# WHISPER_BIN=/path/to/whisper-server
# WHISPER_MODEL=/path/to/ggml-large-v3-turbo.bin
# WHISPER_CPU=1
# To reuse an existing local Whisper server instead of spawning one:
# WHISPER_URL=http://127.0.0.1:8080

# Optional local translator. Install Ollama and pull this model first.
OLLAMA_MODEL=translategemma:4b
OLLAMA_URL=http://127.0.0.1:11434
# Optional binary to start automatically when that endpoint is unavailable:
# OLLAMA_BIN=/path/to/ollama

# For custom model names: OLLAMA_PROFILE=translategemma or chat

# Install Qwen with npm run setup:qwen:mac (Apple Silicon + uv).
# Qwen becomes the default when its environment exists; Whisper stays selectable.
# ASR_ENGINE=qwen
# QWEN_PYTHON=/absolute/path/to/python
# QWEN_MODEL=moona3k/mlx-qwen3-asr-0.6b-4bit

# CPU fallback isolates ASR. On Apple Silicon, try OLLAMA_NUM_GPU=99
# for lower translation latency; benchmark concurrent ASR on your Mac.
OLLAMA_NUM_GPU=0
OLLAMA_NUM_THREAD=2

# Optional full interlinear meanings; install this separately in Ollama.
# GLOSS_MODEL=qwen3:4b

# Optional separate EXISTING local Ollama endpoint for hints (defaults to OLLAMA_URL):
# GLOSS_URL=http://127.0.0.1:11436

# CPU (0) remains default. GPU (99) can speed meanings but competes with ASR.
# GLOSS_NUM_GPU=0
